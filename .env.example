# Environment variables for PRism
# Copy this to .env and fill in your values

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=PRism
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Create a PAT at https://github.com/settings/tokens with repo + read:org scopes
GITHUB_TOKEN=ghp_your_token_here

# Optional: for webhook signature validation
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Choose "gemini", "openai", or "anthropic"
LLM_PROVIDER=gemini

# Google Gemini (OpenAI-compatible)
GEMINI_API_KEY=AIzaSy...your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Analysis ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=500000
MAX_REPO_SIZE_MB=500
ANALYSIS_TIMEOUT_SECONDS=300
